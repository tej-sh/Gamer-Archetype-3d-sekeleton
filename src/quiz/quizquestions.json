{
  "meta": {
    "title": "Skeleton Poker Night: What's Your Gamer Archetype?",
    "version": "3.0-short",
    "language_style": "gen-z meme, dark humor, no emojis, short text for small cards",
    "description": "20-question meme-style gamer personality quiz with dark humor. Each option adds 0-3 points to all four archetypes. Highest total wins.",
    "total_questions": 20,
    "options_per_question": 4,
    "score_range_per_option": [
      0,
      3
    ],
    "text_limits": {
      "question_max_chars": 32,
      "option_max_chars": 32
    }
  },
  "theme": {
    "name": "Skeleton Poker Night",
    "scene": "Three low-poly skeletons (witch hat, horned helmet, big cracked skull) playing poker at a green felt table with beer bottles, chips, cards, and an arcade cabinet in the back.",
    "palette_hint": [
      "dark moody background",
      "felt green table",
      "glowing yellow skeleton eyes",
      "warm wood brown"
    ]
  },
  "intro": {
    "headline": "Pull up a chair.",
    "subtext": "The skeletons are dealing your gamer personality.",
    "button_text": "Deal me in"
  },
  "error_screen": {
    "text": "if you see this the quiz is dead. you're probably a Goofball."
  },
  "archetypes": {
    "survivor": {
      "key": "S",
      "name": "Survivor",
      "core_personality": "Cautious, adaptive, resourceful, focused on staying alive",
      "seat": "The skeleton hugging his chips and still alive somehow",
      "result_blurb": "You hoard chips like last organs. Everyone here died already, you're still dodging it. Cockroach energy."
    },
    "goofball": {
      "key": "G",
      "name": "Goofball",
      "core_personality": "Playful, experimental, unpredictable, chaos-loving",
      "seat": "The one who bluffs with a pair of 2s and a dream",
      "result_blurb": "Pair of 2s and a dream. You'll lose everything, laugh, and haunt the table anyway."
    },
    "predator": {
      "key": "P",
      "name": "Predator",
      "core_personality": "Aggressive, competitive, confident, willing to take risks",
      "seat": "The big cracked skull staring you down, chips stacked high",
      "result_blurb": "Big skull energy. You took the pot and their will to queue again."
    },
    "tactician": {
      "key": "T",
      "name": "Tactician",
      "core_personality": "Analytical, strategic, precise, focused on efficiency",
      "seat": "The helmet skeleton counting cards",
      "result_blurb": "You count cards, odds, and your remaining weekends. The helmet skeleton nods."
    }
  },
  "scoring": {
    "method": "sum_all_selected_option_scores",
    "winner": "archetype_with_highest_total",
    "default_question_weight": 1,
    "question_weight_overrides": {
      "14": {
        "weight": 1,
        "note": "Aesthetic is a weak personality signal. Can be lowered to 0.5 or dropped if desired."
      }
    },
    "tie_break": {
      "primary": "Use the scores from the option picked on Question 20",
      "secondary": "If still tied, pick the archetype with the most 3-point hits across all answers",
      "final": "If still tied, show the Goofball result"
    },
    "max_possible_per_archetype": {
      "survivor": 56,
      "goofball": 60,
      "predator": 55,
      "tactician": 54
    }
  },
